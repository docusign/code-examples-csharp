@{
    int formNumber = 0;
    int phoneAuthFormNumber = 1;
    int signerEmailInputNumber = 0;
    int signerNameInputNumber = 1;
    int countryCodeInputNumber = 0;
    int phoneNumberInputNumber = 1;
}

<h4>@Html.Raw(ViewBag.CodeExampleText.ExampleName)</h4>
<p>@Html.Raw(ViewBag.CodeExampleText.ExampleDescription)</p>

@if (ViewBag.showDoc == true)
{
    <p><a target='_blank' href='@ViewBag.documentation'>Documentation</a> about this example</p>
}

<partial name="../../../Views/Shared/LinkToMethodView" model="ViewBag.CodeExampleText" />

<p>
@Html.Raw(@String.Format(ViewBag.SupportingTexts.ViewSourceFile, "<a target='_blank' href=" + @ViewBag.source + ">FocusedView.cs</a>"))
</p>

<form class="eg" action="" method="post" data-busy="form">
    <div class="form-group">
        <label for="signerEmail">
            @Html.Raw(ViewBag.CodeExampleText.Forms[formNumber].Inputs[signerEmailInputNumber].InputName)
        </label>

        <input type="email"
            class="form-control" 
            id="signerEmail" 
            name="signerEmail"
            aria-describedby="emailHelp" 
            placeholder="@ViewBag.CodeExampleText.Forms[formNumber].Inputs[signerEmailInputNumber].InputPlaceholder" 
            required
            value="@ViewBag.Locals.DsConfig.SignerEmail">

        <small id="emailHelp" class="form-text text-muted">
            @Html.Raw(ViewBag.SupportingTexts.HelpingTexts.EmailWontBeShared)
        </small>
    </div>
    <div class="form-group">
        <label for="signerName">
            @Html.Raw(ViewBag.CodeExampleText.Forms[formNumber].Inputs[signerNameInputNumber].InputName)
        </label>

        <input type="text" 
            class="form-control" 
            id="signerName" 
            placeholder="@ViewBag.CodeExampleText.Forms[formNumber].Inputs[signerNameInputNumber].InputPlaceholder" 
            name="signerName"
            value="@ViewBag.Locals.DsConfig.SignerName"
            required />
    </div>

    <br />

    @if (ViewBag.CodeExampleText.Forms.Count > phoneAuthFormNumber && ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].FormName != null)
    {
        @Html.Raw(ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].FormName)
    }

    <div class="form-group">
        <label for="countryCode">@ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].Inputs[countryCodeInputNumber].InputName</label>
        <input type="text"
            class="form-control"
            id="countryCode"
            name="countryCode"
            placeholder="@ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].Inputs[countryCodeInputNumber].InputPlaceholder" />
    </div>

    <div class="form-group">
        <label for="phoneNumber">@ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].Inputs[phoneNumberInputNumber].InputName</label>
        <input type="text"
            class="form-control"
            id="phoneNumber"
            name="phoneNumber"
            aria-describedby="phoneHelp"
            placeholder="@ViewBag.CodeExampleText.Forms[phoneAuthFormNumber].Inputs[phoneNumberInputNumber].InputPlaceholder" />
        <small id="phoneHelp" class="form-text text-muted">Provide a phone number to enable phone authentication for the signer.</small>
    </div>

    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">@Html.Raw(ViewBag.SupportingTexts.SubmitButton)</button>
</form>
